
@model IEnumerable<DatabaseBackupUtility.Web.Models.BackupJob>

@{
    ViewData["Title"] = "Backup Jobs";
}

<div class="container mt-4">
    <h1>Backup Jobs</h1>
    <p>View and run database backup jobs.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No backup jobs have been recorded yet.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Database</th>
                    <th>Created (UTC)</th>
                    <th>Status</th>
                    <th>Backup File</th>
                    <th>Error</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var job in Model)
                {
                    <tr>
                        <td>@job.Id</td>
                        <td>@job.DatabaseName</td>
                        <td>@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@job.Status</td>
                        <td>@(job.BackupFilePath ?? "Not created")</td>

                        <!-- Display an error message if the backup failed. -->
                        <td>@(job.ErrorMessage ?? "—")</td>

                        <td>
                            <!-- Send a POST request to run this backup job. -->
                            <form asp-action="RunBackup"
                                  asp-route-id="@job.Id"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-primary btn-sm"
                                        disabled="@(job.Status == "Running")">
                                    Run Backup
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
